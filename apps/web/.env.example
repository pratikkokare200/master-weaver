# The Observation Deck's environment. Copy to .env.local and fill in.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# The ledger. Owner or service-role connection — this is what renders every page and what the
# repair route enqueues jobs with. Use the direct connection or the SESSION pooler, never the
# transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------------------------
# Text-to-SQL. Both are needed; with either missing, the Chat panel says it is not configured
# rather than falling back to a connection that can write.
# ---------------------------------------------------------------------------------------------

# The read-only role created by supabase/migrations/0003_readonly_role.sql. Give it a password
# once, out of band — `alter role weaver_readonly with login password '…'` — and put that
# connection string here. It must NOT be a superuser: a superuser bypasses every grant, and the
# app refuses to run generated SQL on one.
DATABASE_URL_READONLY=

# https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
