# ---------------------------------------------------------------------------------------------
# @weaver/worker
#
# Copy to .env and fill in. The worker validates all of this at boot and exits 78 (EX_CONFIG) with
# a readable message rather than starting up and misbehaving quietly.
# ---------------------------------------------------------------------------------------------

# Required. Supabase: Project Settings > Database > Connection string > URI.
# Use the direct connection or the session pooler, NOT the transaction pooler: the queue claim
# holds a row lock for the duration of a statement, and transaction pooling breaks session state.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Required. Doc 01 section 6.2: the key comes from the environment, never an interactive login on
# the server. A server that depends on `brightdata login` is a server that breaks on a fresh deploy.
BRIGHTDATA_API_KEY=

# ---------------------------------------------------------------------------------------------
# Optional -- shown with their defaults
# ---------------------------------------------------------------------------------------------

# Queue poll interval. Only applies when the queue is empty; a backlog is drained back to back.
# WORKER_POLL_INTERVAL_MS=10000

# The price cron. Ticks are aligned to the wall clock, so 900000 lands on :00, :15, :30 and :45.
# Halved from 30 minutes on Day 3 to recover history density (audit F3). A Chaos Lab run was
# measured at 0 credits, so the interval is bounded by politeness to the target, not by budget.
# WORKER_CRON_INTERVAL_MS=900000

# Fire the cron at boot instead of waiting for the next aligned tick. Off by default: a restart
# loop would otherwise scrape every collector on every restart and bill for it.
# WORKER_CRON_ON_BOOT=false

# A CLAIMED job older than this is assumed to belong to a worker that died, and is recovered.
# Must comfortably exceed the CLI's own 180s run timeout.
# WORKER_CLAIM_TIMEOUT_MS=600000

# Total claims per job before it is abandoned as FAILED. Defaults to
# BREAKER_LIMITS.TRANSIENT_RETRIES + 1 from @weaver/contracts.
# WORKER_MAX_ATTEMPTS=3

# Base delay for the transient-failure backoff; doubles per attempt, capped at 64x.
# WORKER_RETRY_BACKOFF_MS=30000

# How long shutdown waits for the in-flight job before forcing an exit.
#
# The default outlasts the CLI's own 180s run timeout, so an in-flight job always finishes. That
# only works on a platform that waits: Railway and Render both SIGKILL about 30 seconds after
# SIGTERM and do not let you change it, so set 25000 there — the worker then exits on its own
# terms, and logs that it did, inside the window it has. It warns at boot if it detects one of
# those platforms and this is still too long.
# WORKER_SHUTDOWN_GRACE_MS=240000     # Fly, or a machine you control
# WORKER_SHUTDOWN_GRACE_MS=25000      # Railway, Render

# How many recent HEALTHY runs feed the trailing median row count behind the FHS row penalty.
# WORKER_ROW_HISTORY_WINDOW=5

# Identifies this process in jobs.claimed_by. Defaults to hostname#pid#random.
# WORKER_ID=

# debug | info | warn | error. debug logs every CLI invocation with its redacted argv.
# LOG_LEVEL=info

# TLS. Off automatically for localhost, on with full chain verification for anything else.
# Set DATABASE_SSL_REJECT_UNAUTHORIZED=false only for a self-signed certificate -- it is scoped to
# this connection, unlike NODE_TLS_REJECT_UNAUTHORIZED which disables verification process-wide.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Discord. Fires on exactly three events: RESTORED, QUARANTINED and PENDING_OPERATOR -- never on
# transient failures and never on the autonomous transitions in between. Alert fatigue is a design
# flaw, and a channel that pings on every state change is a channel people mute.
# Leave unset to disable notification entirely; the engine's decisions do not depend on it.
# DISCORD_WEBHOOK_URL=

# Where the Observation Deck lives, for the PENDING_OPERATOR deep link /c/<id>?action=repair.
# APP_BASE_URL=http://localhost:3000

# The Web Unlocker zone the transient-vs-structural probe runs through (doc 01 section 4.3).
#
# REQUIRED for healing. `brightdata scrape` refuses to run without one -- "No Web Unlocker zone
# specified" -- and that probe is what separates "the site changed" from "the site blocked us".
# Without it every ambiguous failure quarantines instead of healing, which is safe but useless.
# `brightdata zones --json` lists what the account has.
BRIGHTDATA_UNLOCKER_ZONE=chaos_lab_unlocker

# Local development only: let the CLI fall back to credentials from `brightdata login`.
# BRIGHTDATA_ALLOW_STORED_CREDENTIALS=false

# Postgres connections held open. Supabase caps these per project; lower it if you are near the cap.
# WORKER_DB_POOL_MAX=4
